# /etc/caddy/Caddyfile — Caddy gets and renews the HTTPS certificates itself.
# Point each name's DNS A record at the droplet's IP first.

vault.example.com {
	request_body {
		max_size 6MB
	}
	reverse_proxy 127.0.0.1:8787
}

