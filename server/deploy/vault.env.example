# /etc/startblank/vault.env — read by the systemd service. Keep it private:
#   sudo chmod 600 /etc/startblank/vault.env

# Where notes live: one folder per account, <VAULT_ROOT>/<user id>/…
# Point this at a DigitalOcean Volume so the notes survive the droplet.
VAULT_ROOT=/mnt/vaults/vaults

# Only Caddy talks to the service directly.
HOST=127.0.0.1
PORT=8787

# Your Supabase project (Project Settings > API).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret: used only to write the search index. Never put it in the web app.
SUPABASE_SERVICE_ROLE_KEY=

# Only if your project still uses the legacy JWT secret (Project Settings >
# JWT Keys). Projects on JWT signing keys need nothing here.
# SUPABASE_JWT_SECRET=

# The web app's origin(s), comma-separated, exactly as the browser sends them.
ALLOWED_ORIGINS=https://app.example.com

# MAX_FILE_BYTES=5242880
# WATCH=1
