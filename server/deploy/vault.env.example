# /etc/startblank/vault.env — read by the systemd service. Keep it private:
#   sudo chmod 600 /etc/startblank/vault.env

# The server connects as startblank_app: a role that owns nothing and is
# subject to row-level security. Use the password you gave it.
DATABASE_URL=postgres://startblank_app:APP_PASSWORD@127.0.0.1:5432/startblank

# Only Caddy talks to the service directly.
HOST=127.0.0.1
PORT=8787

# Your Supabase project (Project Settings > API) — used only to verify
# sign-in tokens. No Supabase secret key is needed on this server.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Only if your project still uses the legacy JWT secret (Project Settings >
# JWT Keys). Projects on JWT signing keys need nothing here.
# SUPABASE_JWT_SECRET=

# The web app's origin(s), comma-separated, exactly as the browser sends them.
ALLOWED_ORIGINS=https://app.example.com

# MAX_NOTE_BYTES=5242880
