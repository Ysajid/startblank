# /etc/systemd/system/startblank-vault.service
[Unit]
Description=startblank vault server (notes in Postgres)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
User=startblank
Group=startblank
WorkingDirectory=/opt/startblank/server
EnvironmentFile=/etc/startblank/vault.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=2

# Hardening: the service needs the network (Postgres, Supabase's public
# keys) and nothing on disk.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
